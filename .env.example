# Local development only. Copy to .env and fill in. Never commit real values.
# In Streamlit in Snowflake none of these are needed: the connection is embedded and the
# pepper is read from MEDIVERSE360.SECURITY.APP_KEYS.

# Name of a connection in ~/.snowflake/connections.toml (role MV_APP_OWNER, warehouse MEDIVERSE_WH)
SNOWFLAKE_DEFAULT_CONNECTION_NAME=mediverse_dev

# Optional override of the server-side password/OTP pepper for an isolated local database.
# Leave unset to use the value stored in Snowflake. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MEDIVERSE_PEPPER=

# true  = on-screen OTP and labelled mock biometrics (synthetic demos)
# false = OTP sent via SYSTEM$SEND_EMAIL (requires MEDIVERSE_EMAIL_INTEGRATION)
MEDIVERSE_DEMO_MODE=true
MEDIVERSE_EMAIL_INTEGRATION=
